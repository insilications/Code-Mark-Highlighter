{
  "rules": {
    "legibility/hoist-if-operators": "error",
    "legibility/max-array-chain-depth": "error",
    "legibility/max-control-flow-depth": "error",
    "legibility/max-expression-operators": "error",
    "legibility/max-function-parameters": "error",
    "legibility/no-automated-comment-attribution": "error",
    "legibility/no-complex-ternaries": "error",
    "legibility/no-computed-values": "error",
    "legibility/no-direct-node-bin-smoke": "error",
    "legibility/no-hidden-side-effects": "error",
    "legibility/no-identity-array-callback": "error",
    "legibility/no-mixed-filename-casing": "error",
    "legibility/no-quadratic-patterns": "error",
    "legibility/no-redundant-boolean-logic": "error",
    "legibility/no-redundant-nullish-fallback": "error",
    "legibility/no-repeated-collection-search": "error",
    "legibility/no-single-use-renaming-alias": "error",
    "legibility/no-small-collection-conversion": "error",
    "legibility/no-stacked-comments": "off",
    "legibility/no-standalone-array-mutations": "error",
    "legibility/no-trivial-wrapper-functions": "error",
    "legibility/no-unmatched-comments": "off",
    "legibility/no-unnecessary-async": "warn",
    "legibility/no-unnecessary-block-callback": "error",
    "legibility/prefer-concat-object-assign": "off",
    "legibility/prefer-early-return": "error",
    "legibility/prefer-flat-map": "error",
    "legibility/prefer-guard-clauses": "error",
    "legibility/prefer-object-lookup": "error",
    "legibility/prefer-positive-condition-names": "error",
    "legibility/require-executable-shebang": "warn",
    "legibility/require-filename-matches-dirname": "off",
    "legibility/require-jsdoc-multiline-comments": "warn"
  }
}
