{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "outDir": "out",
    "lib": ["es2024"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "exclude": ["node_modules", ".vscode-test"]
}
