{
  "rules": {
    "legibility/hoist-if-operators": [ "warn", {"max": 1} ],
    "legibility/max-array-chain-depth": [ "warn", {"max": 2} ],
    "legibility/max-control-flow-depth": [ "warn", {"max": 4} ],
    "legibility/max-expression-operators": [ "warn", {"max": 7} ],
    "legibility/max-function-parameters": [ "warn", {"max": 5} ],
    "legibility/no-automated-comment-attribution": "off",
    "legibility/no-complex-ternaries": "off",
    "legibility/no-computed-values": "off",
    "legibility/no-direct-node-bin-smoke": "warn",
    "legibility/no-hidden-side-effects": "warn",
    "legibility/no-identity-array-callback": "warn",
    "legibility/no-mixed-filename-casing": "warn",
    "legibility/no-quadratic-patterns": "warn",
    "legibility/no-redundant-boolean-logic": "warn",
    "legibility/no-redundant-nullish-fallback": "warn",
    "legibility/no-repeated-collection-search": "warn",
    "legibility/no-single-use-renaming-alias": "warn",
    "legibility/no-small-collection-conversion": "off",
    "legibility/no-stacked-comments": "off",
    "legibility/no-standalone-array-mutations": "off",
    "legibility/no-trivial-wrapper-functions": "warn",
    "legibility/no-unmatched-comments": "off",
    "legibility/no-unnecessary-async": "warn",
    "legibility/no-unnecessary-block-callback": "warn",
    "legibility/prefer-concat-object-assign": "off",
    "legibility/prefer-early-return": "warn",
    "legibility/prefer-flat-map": "warn",
    "legibility/prefer-guard-clauses": "warn",
    "legibility/prefer-object-lookup": "warn",
    "legibility/prefer-positive-condition-names": "warn",
    "legibility/require-executable-shebang": "warn",
    "legibility/require-filename-matches-dirname": "off",
    "legibility/require-jsdoc-multiline-comments": "warn"
  }
}
